# Free demo mode (no paid OpenAI). Set true on Render if you have no OpenAI credits.
MOCK_LLM=true

# OpenAI Configuration (only needed when MOCK_LLM=false)
# Personal OpenAI key for chat + text-embedding-3-small.
OPENAI_API_KEY=your_openai_api_key_here
# Optional: LiteLLM-compatible gateway for local/KV use only.
# OPENAI_BASE_URL=https://llm.keyvalue.systems

# CORS — comma-separated frontend origins.
# On Render, *.onrender.com is also allowed by regex in main.py; still set this to your static site URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Qdrant Configuration
# For local: http://localhost:6333
# For cloud: https://your-cluster.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Only needed for Qdrant Cloud

# LangSmith Configuration (optional - for tracing)
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=know-your-product
