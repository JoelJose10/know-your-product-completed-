# LLM — OpenRouter (recommended)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_HTTP_REFERER=https://know-your-product-web-b1pr.onrender.com
OPENROUTER_APP_TITLE=Know Your Product

# Or Official OpenAI / KeyValue LiteLLM
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=   # empty for api.openai.com, or https://llm.keyvalue.systems
# LITE_LLM_KEY=...   # legacy alias; also sets KeyValue base URL when OpenRouter/OpenAI unset

# CORS — comma-separated frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LangSmith Configuration (optional)
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=know-your-product
