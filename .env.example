# Lite LLM Configuration (KeyValue Systems)
# Get your key from the IT team or project lead
# Note: Only KV IPs are whitelisted. Use VPN if accessing outside office.
LITE_LLM_KEY=your_lite_llm_key_here

# Qdrant Configuration
# For local: http://localhost:6333
# For cloud: https://your-cluster.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Only needed for Qdrant Cloud

# LangSmith Configuration (optional - for tracing)
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=know-your-product
